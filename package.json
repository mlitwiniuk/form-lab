{
  "name": "form-lab",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "setup": "npm --prefix frontend ci",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend test",
    "preview": "npm --prefix frontend run preview",
    "deploy:check": "npm run build && npm --prefix frontend run deploy:check",
    "deploy": "npm run build && npm --prefix frontend run deploy",
    "cloudflare:login": "npm --prefix frontend run cloudflare:login",
    "cloudflare:whoami": "npm --prefix frontend run cloudflare:whoami"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
