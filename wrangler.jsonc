{
  "$schema": "./frontend/node_modules/wrangler/config-schema.json",
  "name": "form-lab",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "form-lab.app", "custom_domain": true }
  ]
}
