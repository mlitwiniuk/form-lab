# Exact browser-facing HTTPS origin, without a trailing slash.
FORM_LAB_ORIGIN=https://form-lab.example.com
# Public email signup; set false to close registration without disabling recovery.
FORM_LAB_REGISTRATION_ENABLED=true
# mailgun | smtp | disabled. Local-only testing also supports file.
FORM_LAB_MAIL_TRANSPORT=mailgun
FORM_LAB_MAIL_FROM="Form Lab <no-reply@example.com>"
# Mailgun HTTP API: choose the region of your sending domain.
FORM_LAB_MAILGUN_REGION=us
FORM_LAB_MAILGUN_DOMAIN=mg.example.com
FORM_LAB_MAILGUN_API_KEY=
# SMTP alternative: implicit TLS with certificate verification, usually port 465.
FORM_LAB_SMTP_HOST=smtp.mailgun.org
FORM_LAB_SMTP_PORT=465
FORM_LAB_SMTP_USERNAME=
FORM_LAB_SMTP_PASSWORD=
